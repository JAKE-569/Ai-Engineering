# GEMINI_API_KEY: Required for Gemini Vision drawing review.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Vertex AI Gemini (preferred for Google Cloud billing/Welcome credit)
VERTEX_AI_PROJECT_ID="YOUR_GOOGLE_CLOUD_PROJECT_ID"
VERTEX_AI_LOCATION="global"
VERTEX_AI_API_KEY="YOUR_VERTEX_AI_API_KEY"
VERTEX_AI_MODEL="gemini-3-flash-preview"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase Project URL (e.g., https://xyz.supabase.co)
VITE_SUPABASE_URL=""

# SUPABASE_ANON_KEY: Your Supabase Public Anon Key
VITE_SUPABASE_ANON_KEY=""
