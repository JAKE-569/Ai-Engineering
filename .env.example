# 회사 PC 로컬 실행. .env에 복사해 사용하세요.
# 우선순위: .env.local > .env > 기존 환경변수. 키 값은 Git에 저장하지 마세요.
GOOGLE_GEMINI_BASE_URL=http://aigpt.posco.net/gpgpta01-gpt
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite
# OS에 이미 사내 UUID 키가 설정되어 있으면 아래 줄은 주석으로 둡니다.
# GEMINI_API_KEY=사내_UUID_API_Key
# GPT/Claude도 같은 사내 키를 사용합니다. 별도 지정 시 PGPT_API_KEY가 우선합니다.
# PGPT_API_KEY=사내_UUID_API_Key
PGPT_GPT_MODELS=gpt-5.4
PGPT_CLAUDE_MODELS=claude-sonnet-4.6
# 화면의 'GPT · Claude 모델 설정'으로 저장한 local-data/ai-model-settings.json이 있으면 우선 적용됩니다.
# 쉼표로 모델 ID를 추가하면 업로드 화면에서 선택할 수 있습니다.
# 예: PGPT_GPT_MODELS=gpt-5.4,gpt-5.4-mini
# 예: PGPT_CLAUDE_MODELS=claude-sonnet-4.6,claude-opus-4.7
# 아래 주소를 생략하면 GOOGLE_GEMINI_BASE_URL에서 파생합니다.
# PGPT_GPT_BASE_URL=http://aigpt.posco.net/gpgpta01-gpt/v1
# PGPT_CLAUDE_BASE_URL=http://aigpt.posco.net/gpgpta01-gpt
# PGPT_TIMEOUT_MS=120000
# 개발계로 바꾸려면 .env.local의 주소도 함께 변경하세요.
# GOOGLE_GEMINI_BASE_URL=http://taigpt.posco.net/gpgpta01-gpt

# 선택: Cloud Vision OCR은 P-GPT 인증과 별개입니다.
# GOOGLE_CLOUD_VISION_API_KEY=
# GOOGLE_CLOUD_VISION_USE_ADC=true
# 선택: NVIDIA 법규 검색에는 아래 세 가지 값이 모두 필요합니다.
# NVIDIA_API_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# VECTOR_DB_COLLECTION=engineering_rules
# HTTPS_PROXY=http://proxy.company.com:8080
# EXTRA_CA_CERTS_FILE=C:/certs/company-root.pem
# PORT=3000
# OPEN_BROWSER=false
# GEMINI_TIMEOUT_MS=60000
# NVIDIA_REQUEST_TIMEOUT_MS=120000
