# ------------------------------------------------------------------
# 로컬 서버용 설정 파일 예시
# 1) 이 파일을 복사해서 이름을 ".env" 로 만드세요. (start-local.bat 이 자동으로 해줍니다)
# 2) 따옴표 안의 값을 실제 키로 바꾸세요.
# 3) .env 파일은 절대 GitHub에 올리지 마세요. (.gitignore 에 이미 제외되어 있습니다)
# ------------------------------------------------------------------

# [Gemini 검토] 업로드 화면에서 Gemini 를 선택할 때 필요
GEMINI_API_KEY=""

# [선택] Gemini 모델 순서. 비워두면 고성능 모델부터 차례로 시도합니다:
#   gemini-3.8-flash > gemini-3.6-flash > gemini-3.5-flash-lite > gemini-3.1-flash-lite
# 한도 초과(429), 사용 불가(403/404), 과부하(503) 때 다음 모델로 넘어갑니다. 순서를 바꾸려면 쉼표로 적으세요.
# GEMINI_MODELS="gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite"

# [선택] Google Cloud Vision OCR. 둘 다 비워두면 OCR 없이 Gemini 만으로 검토합니다.
# 방법 A: API 키
GOOGLE_CLOUD_VISION_API_KEY=""
# 방법 B: 키 없이 gcloud 로그인(ADC) 사용. 먼저 명령창에서
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project 내프로젝트ID
# 를 실행한 뒤 아래를 true 로 바꾸세요. (방법 A 키가 있으면 키가 우선입니다)
GOOGLE_CLOUD_VISION_USE_ADC=""

# [NVIDIA 검토] 업로드 화면에서 NVIDIA 를 선택할 때 필요 (아래 Supabase 도 함께 필요)
NVIDIA_API_KEY=""

# [NVIDIA 검토용 법규 DB] Supabase pgvector
# 먼저 supabase/migrations/20260813_engineering_rules_vector.sql 을 Supabase 에 적용해야 합니다.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---- 회사 네트워크에서 "fetch failed" 가 날 때 (LOCAL_SERVER.md 참고) ----
# 회사 프록시 주소 (IT 부서에 문의). 예: http://proxy.company.com:8080
# HTTPS_PROXY=""
# IT 부서에서 받은 회사 루트 인증서 파일 경로 (.pem 또는 Base64 .crt). 예: C:\certs\company-root.pem
# EXTRA_CA_CERTS_FILE=""
# Windows 인증서 저장소 사용 (기본 켜짐). 끄려면 false
# USE_SYSTEM_CA=false

# ---- 아래는 보통 바꿀 필요 없습니다 (비워두면 기본값 사용) ----
# PORT=3000
# OPEN_BROWSER=false
# Gemini 한 번 요청의 최대 대기 시간(ms)과, 모든 모델이 막혔을 때 기다리는 최대 시간(ms)
# GEMINI_TIMEOUT_MS=120000
# GEMINI_MAX_WAIT_MS=90000
# NVIDIA_VISION_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning"
# NVIDIA_EMBEDDING_MODEL="nvidia/nemotron-3-embed-1b"
# NVIDIA_TEXT_MODEL="nvidia/nemotron-3-nano-30b-a3b"
# NVIDIA_REQUEST_TIMEOUT_MS=150000
# NVIDIA_MAX_ATTEMPTS=1
# VECTOR_DB_COLLECTION="engineering_rules"
